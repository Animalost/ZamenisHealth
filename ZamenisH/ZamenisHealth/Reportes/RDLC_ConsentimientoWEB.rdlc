        <Top>44.93253cm</Top>
        <Left>0.65828cm</Left>
        <Height>0.6cm</Height>
        <Width>17.67896cm</Width>
        <ZIndex>11</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
