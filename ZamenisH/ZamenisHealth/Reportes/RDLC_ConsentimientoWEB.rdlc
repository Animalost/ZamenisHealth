<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Textbox Name="Textbox21">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Autorización del paciente para realizar los procedimientos, una vez conocidos, al igual que sus riesgos y beneficios.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Cumplimiento Ley 23 de 1981(Arts. 15 y 16)</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Usted tiene el derecho como paciente a </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>conocer su condición</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value> y las </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>opciones diagnósticas y/o terapéuticas</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value> que pueden ser necesarias en su caso. También tiene derecho a </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>conocer los riesgos</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value> que pueden derivarse de esas opciones. El ser informado le permite a usted tomar libremente la decisión de aceptar o no el procedimiento que su médico le propone.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Debe tener en cuenta que la práctica médica no es una ciencia exacta y por eso los resultados a veces no son los esperados, por esta razón de ninguna manera se prometen o garantizan resultados.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Todo procedimiento médico, implica eventuales riesgos, complicaciones y efectos colaterales y adversos que son previstos e imprevistos. La probabilidad de que ocurra uno de estos eventos depende de la condición médica previa del paciente (que en</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve"> </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>Red</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>algunas ocasiones se puede conocer y en otras no), de la naturaleza del procedimiento y de las técnicas usadas. Estos eventos adversos pueden presentarse en la sala de procedimientos, o en la casa horas o días después.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>A.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve">            </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>¿EN QUÉ CONSISTE EL PROCEDIMIENTO, CUÁL ES SU FINALIDAD?</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>A usted se le realizará una curación avanzada, la cual se basa en el principio del ambiente húmedo, utilizando apósitos de alta tecnología que favorecen la cicatrización al estimular el microambiente de la herida, son curaciones realizadas con una periodicidad de 3 a 7 días, según el tipo de herida, con disminución del dolor y costo efectivos; favorecen el cierre rápido y óptimo de todo tipo de heridas.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
              <LineHeight>13pt</LineHeight>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
              <LineHeight>13pt</LineHeight>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Beneficios: </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>La curación con tecnología y en ambiente húmedo reduce el tiempo de cicatrización, disminuye el riesgo de infección por la minimización de la exposición de la herida al entorno, disminuye eventos de hospitalización, la estética de la cicatriz mejora, da sensación de tranquilidad porque usted como paciente no se tiene que ocupar del manejo de la herida.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
              <LineHeight>13pt</LineHeight>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
              <LineHeight>13pt</LineHeight>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Alternativas de Tratamiento:</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value> Cuando usted decide no realizarse la curación avanzada puede optar por curaciones tradicionales las cuales se realizan sin apósitos y con una periodicidad mayor, generalmente diaria.  Si es remitido a un especialista en cirugía plástica este último puede optar por la realización de un injerto o colgajo, sin embargo para estos procedimientos usted debe cumplir ciertos requisitos y la herida debe estar en óptimas condiciones para asegurar el éxito de cualquiera de estos procedimientos.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>B.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve">            </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>¿LOS RIESGOS, COMPLICACIONES, EFECTOS SECUNDARIOS O COLATERALES COMUNES Y PREVISIBLES DEL PROCEDIMIENTO QUE ME VAN A HACER SON?</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Se me ha explicado que, existen riesgos de muy baja frecuencia, mencionados a continuación:</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>1.24883cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>1.24883cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Dolor durante el procedimiento.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <ListStyle>Bulleted</ListStyle>
            <ListLevel>1</ListLevel>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Infecciones, con riesgo mayor si el paciente presenta patologías de base como por ejemplo diabetes mellitus, cáncer, presenta desnutrición, consumo de esteroides u otros medicamentos que puedan alterar el sistema inmune, asimismo si es consumidor de cigarrillo o licor.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <HangingIndent>-18pt</HangingIndent>
            <ListStyle>Bulleted</ListStyle>
            <ListLevel>1</ListLevel>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Reacciones alérgicas a los productos o medicamentos utilizados durante el procedimie</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Value>nto.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#404040</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <HangingIndent>-18pt</HangingIndent>
            <ListStyle>Bulleted</ListStyle>
            <ListLevel>1</ListLevel>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Cicatrices deformantes, formación de queloides, hemorragia, Hematomas superficiales.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <HangingIndent>-18pt</HangingIndent>
            <ListStyle>Bulleted</ListStyle>
            <ListLevel>1</ListLevel>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Retardo en la cicatrización de la herida con el agravante de pacientes con enfermedades crónicas debilitantes o consumo de medicamentos que puedan retardar dicha cicatrización.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <HangingIndent>-18pt</HangingIndent>
            <ListStyle>Bulleted</ListStyle>
            <ListLevel>1</ListLevel>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>1.24883cm</LeftIndent>
            <RightIndent>0cm</RightIndent>
            <HangingIndent>-18pt</HangingIndent>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>C.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve">    </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Value>DECLARACIÓN DE COMPROMISO Y ASUNCIÓN DE LOS EVENTUALES RIESGOS Y COMPLICACIONES.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0cm</LeftIndent>
